@model IEnumerable<CMSv2026WebApp.Models.Patient>

@{
    ViewData["Title"] = "Patient Management";
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Toastr CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
<!-- Custom CSS -->
<style>
    body {
        background: #f8f9fa;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .card-header {
        background: linear-gradient(45deg, #007bff, #0056b3); /* Improved contrast */
        color: #fff;
        border-radius: 15px 15px 0 0;
    }

    .btn-success {
        background: linear-gradient(45deg, #28a745, #218838);
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .btn-primary {
        background: linear-gradient(45deg, #007bff, #0056b3);
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .btn-warning {
        background: linear-gradient(45deg, #ffc107, #e0a800);
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .btn-danger {
        background: linear-gradient(45deg, #dc3545, #c82333);
        border: none;
        border-radius: 8px;
        padding: 8px 16px;
    }

    .table {
        border-radius: 15px;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(0, 123, 255, 0.05);
    }

    .table-striped tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    .alert-info {
        background: linear-gradient(45deg, #17a2b8, #138496);
        color: #fff;
        border: none;
        border-radius: 8px;
    }

    .btn-sm {
        padding: 5px 10px;
    }
</style>

<div class="container my-5">
    <div class="card shadow-lg">
        <div class="card-header bg-gradient-primary text-white">
            <h4 class="card-title mb-0">
                <i class="fas fa-users me-2"></i>Patient Management
            </h4>
        </div>
        <div class="card-body">
            <!-- Add New Patient Button -->
            <p>
                <a asp-action="AddPatient" class="btn btn-success">
                    <i class="fas fa-plus me-2"></i>Add New Patient
                </a>
            </p>

            <!-- Search Form -->
            <form asp-action="SearchPatients" method="get" class="mb-4">
                <div class="row">
                    <div class="col-md-8">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search by Name, Mobile Number, or Email" />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-2"></i>Search
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times me-2"></i>Clear
                        </a>
                    </div>
                </div>
            </form>

            <!-- Patient Table -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Patient ID</th>
                                <th>Patient Name</th>
                                <th>Age</th>
                                <th>Gender</th>
                                <th>Mobile Number</th>
                                <th>Email</th>
                                <th>Address</th>
                                <th>Registration ID</th>
                                <th>Blood Group</th>
                                <th>Is Active</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                var age = DateTime.Now.Year - patient.DateOfBirth.Year;
                                if (patient.DateOfBirth > DateTime.Now.AddYears(-age))
                                {
                                    age--;
                                }
                                <tr>
                                    <td>@patient.PatientId</td>
                                    <td>@patient.PatientName</td>
                                    <td>@age</td>
                                    <td>@patient.Gender</td>
                                    <td>@patient.MobileNumber</td>
                                    <td>@patient.Email</td>
                                    <td>@patient.Address</td>
                                    <td>@patient.RegistrationId</td>
                                    <td>@patient.BloodGroup</td>
                                    <td>@(patient.IsActive ? "Yes" : "No")</td>
                                    <td>
                                        <a asp-action="EditPatient" asp-route-id="@patient.PatientId" class="btn btn-warning btn-sm" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="DeactivatePatient" asp-route-id="@patient.PatientId" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Deactivate" onclick="return confirm('Are you sure you want to deactivate this patient?')">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                        <a asp-action="BookAppointment" asp-route-patientId="@patient.PatientId" class="btn btn-primary btn-sm" title="Book Appointment">
                                            <i class="fas fa-calendar-plus"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>No patients found.
                </div>
            }
        </div>
    </div>
</div>

<!-- Bootstrap JS and dependencies -->
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
<!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    // Toastr notifications for actions
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            toastr.success('@TempData["SuccessMessage"]', 'Success', {
                closeButton: true,
                progressBar: true,
                positionClass: 'toast-top-right',
                timeOut: 5000,
            });
        </text>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            toastr.error('@TempData["ErrorMessage"]', 'Error', {
                closeButton: true,
                progressBar: true,
                positionClass: 'toast-top-right',
                timeOut: 5000,
            });
        </text>
    }
</script>