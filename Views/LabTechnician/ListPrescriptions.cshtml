@using System.Linq
@model IEnumerable<CMSv2026WebApp.Models.LabTestPrescription>

@{
    ViewData["Title"] = "List of Prescriptions";
}

<h2>@ViewData["Title"]</h2>

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Prescription ID</th>
                <th>Test Name</th>
                <th>Remarks</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prescription in Model)
            {
                <tr>
                    <td>@prescription.LabTestPrescriptionId</td>
                    <td>@prescription.LabTestValue</td>
                    <td>@prescription.Remarks</td>
                    <td>@prescription.CreatedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a href="@Url.Action("GenerateReport", "LabTechnician", new { prescriptionId = prescription.LabTestPrescriptionId })" class="btn btn-primary">Generate Report</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No prescriptions available.</p>
}
