@model CMSv2026WebApp.ViewModel.DoctorViewModel

@{
    ViewData["Title"] = ViewData["PageTitle"];
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<!-- Animate.css -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
<!-- Custom CSS -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(45deg, #007bff, #00bcd4);
    }

    .card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: none;
        padding: 0.75rem 1rem; /* Reduced padding */
    }

    .card-body {
        padding: 1rem; /* Reduced padding */
    }

    .btn {
        transition: transform 0.2s ease-in-out;
    }

        .btn:hover {
            transform: translateY(-2px);
        }

    .card:hover {
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        transition: box-shadow 0.3s ease-in-out;
    }

    .table-responsive {
        border-radius: 15px;
        overflow: hidden;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: rgba(0, 123, 255, 0.05);
    }

    .table-striped tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    .list-group-item {
        border: none;
        margin-bottom: 8px; /* Reduced margin */
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        padding: 0.5rem 1rem; /* Reduced padding */
    }

    .badge {
        font-size: 0.8rem; /* Reduced font size */
        padding: 0.4em 0.6em; /* Reduced padding */
    }

    .form-control {
        padding: 0.375rem 0.75rem; /* Reduced padding */
        font-size: 0.875rem; /* Reduced font size */
    }

    .card-title {
        font-size: 1rem; /* Reduced font size */
    }

    h6 {
        font-size: 0.875rem; /* Reduced font size */
    }

    small {
        font-size: 0.75rem; /* Reduced font size */
    }
</style>

<div class="container-fluid my-5">
    <div class="row">
        <!-- Left Sidebar -->
        <div class="col-lg-3 col-md-12 col-sm-12 mb-4">
            <!-- Search Patients Card -->
            <div class="card shadow-lg mb-4">
                <div class="card-header bg-gradient-primary text-white">
                    <h4 class="card-title mb-0">Search Patients</h4>
                </div>
                <div class="card-body">
                    <form>
                        <div class="form-group mb-3">
                            <input type="text" class="form-control" placeholder="Enter Patient Name or ID" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-search me-2"></i>Search
                        </button>
                    </form>
                </div>
            </div>

            <!-- Upcoming Appointments Card -->
            <div class="card shadow-lg">
                <div class="card-header bg-gradient-primary text-white">
                    <h4 class="card-title mb-0">Upcoming Appointments</h4>
                </div>
                <div class="card-body">
                    <ul class="list-group">
                        @if (Model.UpcomingAppointments != null && Model.UpcomingAppointments.Any())
                        {
                            @foreach (var appointment in Model.UpcomingAppointments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@appointment.Patient.PatientName</h6>
                                        <small class="text-muted">@appointment.AppointmentDate.ToString("dd-MMM-yyyy hh:mm tt")</small>
                                    </div>
                                    <span class="badge bg-primary">@appointment.TokenNumber</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-center text-muted">No Upcoming Appointments</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Right Content -->
        <div class="col-lg-9 col-md-12 col-sm-12 mb-4">
            <!-- Today's Appointments Card -->
            <div class="card shadow-lg p-4 animate__animated animate__fadeIn animate__delay-0.2s">
                <div class="card-header bg-gradient-primary text-white">
                    <h4 class="card-title mb-0">Today's Appointments</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped text-center">
                            <thead>
                                <tr>
                                    <th>Token Number</th>
                                    <th>Registration ID</th>
                                    <th>Patient Name</th>
                                    <th>Gender</th>
                                    <th>Age</th>
                                    <th>Appointment Date</th>
                                    <th>Blood Group</th>
                                    <th>Consultation Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TodaysAppointments != null && Model.TodaysAppointments.Any())
                                {
                                    @foreach (var appointment in Model.TodaysAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.TokenNumber</td>
                                            <td>@appointment.Patient.RegistrationId</td>
                                            <td>
                                                <a href="@Url.Action("PatientDetails", "Doctor", new { patientId = appointment.Patient.PatientId })">
                                                    @appointment.Patient.PatientName
                                                </a>
                                            </td>
                                            <td>@appointment.Patient.Gender</td>
                                            <td>
                                                @(appointment.Patient.DateOfBirth != null
                                                    ? (DateTime.Now.Year - appointment.Patient.DateOfBirth.Year).ToString()
                                                    : "N/A")
                                            </td>
                                            <td>@appointment.AppointmentDate.ToString("dd-MMM-yyyy")</td>
                                            <td>@appointment.Patient.BloodGroup</td>
                                            <td>@appointment.ConsultationStatus</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">No Appointments Found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS and dependencies -->
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}