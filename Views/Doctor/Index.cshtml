@model CMSv2026WebApp.ViewModel.DoctorViewModel

@{
    ViewData["Title"] = ViewData["PageTitle"];
}

<h1>Today's Appointments</h1>

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 mb-4">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">List of Patients</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped text-center">
                        <thead>
                            <tr>
                                <th>Token Number</th>
                                <th>Registration ID</th>
                                <th>Patient Name</th>
                                <th>Gender</th>
                                <th>Age</th>
                                <th>Appointment Date</th>
                                <th>Blood Group</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Appointments != null && Model.TodaysAppointments.Any())
                            {
                                @foreach (var appointment in Model.TodaysAppointments)
                                {
                                    <tr>
                                        <td>@appointment.TokenNumber</td>
                                        <td>@appointment.Patient.RegistrationId</td>
                                        <td>
                                            <a href="@Url.Action("PatientDetails", "Doctor", new { patientId = appointment.Patient.PatientId })">
                                                @appointment.Patient.PatientName
                                            </a>
                                        </td>
                                        <td>@appointment.Patient.Gender</td>
                                        <td>
                                            @(appointment.Patient.DateOfBirth != null
                                                ? (DateTime.Now.Year - appointment.Patient.DateOfBirth.Year).ToString()
                                                : " ")
                                        </td>
                                        <td>@appointment.AppointmentDate.ToString("MM/dd/yyyy")</td>
                                        <td>@appointment.Patient.BloodGroup</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center">No Appointments Found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



