@model IEnumerable<CMSv2026WebApp.Models.LabTestResult>

@{
    ViewData["Title"] = "Lab Results";
}

<h1>Lab Results</h1>

<table class="table">
    <thead>
        <tr>
            <th>Report ID</th>
            <th>Lab Test ID</th>
            <th>Report File Path</th>
            <th>Upload Date</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var result in Model)
        {
            <tr>
                <td>@result.ReportID</td>
                <td>@result.LabTestID</td>
                <td>@result.ReportFilePath</td>
                <td>@result.UploadDate.ToString("MM/dd/yyyy")</td>
            </tr>
        }
    </tbody>
</table>
