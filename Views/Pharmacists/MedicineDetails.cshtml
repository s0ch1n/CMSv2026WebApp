@model CMSv2026WebApp.Models.Medicine

<h2>Medicine Details</h2>

<div>
    <p><strong>Name:</strong> @Model.MedicineName</p>
    <p><strong>Expiry Date:</strong> @Model.ExpiryDate.ToShortDateString()</p>
    <p><strong>Unit:</strong> @Model.Unit</p>
    <p><strong>Medicine Type:</strong> @(Model.MedicineType != null ? Model.MedicineType.MedicineTypeName : "Unknown")</p>
</div>

<div>
    <a asp-controller="Doctor" asp-action="MedicineStockList" class="btn btn-primary">Back to List</a>
</div>
