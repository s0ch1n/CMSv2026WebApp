@model IEnumerable<CMSv2026WebApp.Models.Medicine>

<!-- ✅ PAGE HEADER -->
<div class="container mt-4">
    <h2 class="text-primary">Medicine Inventory</h2>

    <!-- ✅ BACK BUTTON -->
    <a href="javascript:history.back()" class="btn btn-outline-secondary mb-3">🔙 Back</a>

    <!-- ✅ ADD BUTTON -->
    <a asp-action="Create" class="btn btn-primary mb-3 float-end">➕ Add New Medicine</a>

    <div class="clearfix"></div> <!-- Clears floating elements -->
</div>

<!-- ✅ SEARCH FORM -->
<div class="container mb-3">
    <form asp-controller="Pharmacists" asp-action="Index" method="get">
        <div class="container mb-3">
            <div class="input-group">
                <input type="text" id="searchBox" class="form-control" placeholder="🔍 Type to search by medicine name"
                       value="@ViewData["SearchName"]" />
            </div>
        </div>

    </form>
</div>

<!-- ✅ MEDICINE TABLE -->
<div class="container">
    <table class="table table-striped table-bordered shadow">
        <thead class="table-primary">
            <tr>
                <th style="width:50px">Name</th>
                <th style="width:50px">Expiry Date</th>
                <th style ="width:50px">Unit</th>
                <th style ="width:50px">Type</th>
                <th style ="width:50px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var medicine in Model)
                {
                    <tr>
                        <td>@medicine.MedicineName</td>
                        <td>@medicine.ExpiryDate.ToString("yyyy-MM-dd")</td>
                        <td>@medicine.Unit</td>
                        <td>@medicine.MedicineType?.MedicineTypeName</td>
                        <td>
                            <a asp-action="Details" asp-route-name="@medicine.MedicineName" class="btn btn-info btn-sm">👁 View</a>
                            <a asp-action="Edit" asp-route-name="@medicine.MedicineName" class="btn btn-warning btn-sm">✏ Edit</a>

                            <!-- DELETE BUTTON (Opens Modal) -->
                            <button type="button" class="btn btn-danger btn-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-name="@medicine.MedicineName">
                                🗑 Deactivate
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-danger">⚠ No medicines found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ✅ DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">⚠ Confirm Deactivate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to deactivate <strong id="medicineName"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post">
                    <input type="hidden" id="medicineToDelete" name="name" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">❌ Cancel</button>
                    <button type="submit" class="btn btn-danger">✅ Yes, Deactivate</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ✅ JAVASCRIPT TO HANDLE DELETE -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var deleteModal = document.getElementById("deleteModal");
        deleteModal.addEventListener("show.bs.modal", function (event) {
            var button = event.relatedTarget;
            var medicineName = button.getAttribute("data-name");
            var deleteForm = document.getElementById("deleteForm");

            // Set medicine name in the modal
            document.getElementById("medicineName").textContent = medicineName;
            document.getElementById("medicineToDelete").value = medicineName;

            // ✅ Ensure the form posts to the correct delete endpoint
            deleteForm.action = "/Pharmacists/Delete";
        });
    });
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<!-----------------For search by name Functionality------------------>


<script>
    $(document).ready(function () {
        $("#searchBox").on("keyup", function () {
            var searchName = $(this).val().trim();

            $.ajax({
                url: "/Pharmacists/SearchMedicine", // ✅ Calls the new JSON endpoint
                type: "GET",
                data: { searchTerm: searchName },
                success: function (data) {
                    var tbody = $("tbody");
                    tbody.empty(); // ✅ Clear existing table rows

                    if (data.length > 0) {
                        $.each(data, function (index, medicine) {
                            tbody.append(`
                                <tr>
                                    <td>${medicine.medicineName}</td>
                                    <td>${medicine.expiryDate ? medicine.expiryDate.split('T')[0] : 'N/A'}</td>
                                    <td>${medicine.unit}</td>
                                    <td>${medicine.medicineType ? medicine.medicineType.medicineTypeName : 'N/A'}</td>
                                    <td>
                                        <a href="/Pharmacists/Details?name=${medicine.medicineName}" class="btn btn-info btn-sm">👁 View</a>
                                        <a href="/Pharmacists/Edit?name=${medicine.medicineName}" class="btn btn-warning btn-sm">✏ Edit</a>
                                        <button type="button" class="btn btn-danger btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-name="${medicine.medicineName}">
                                            🗑 Deactivate
                                        </button>
                                    </td>
                                </tr>
                            `);
                        });
                    } else {
                        tbody.append(`<tr><td colspan="5" class="text-center text-danger">⚠ No medicines found.</td></tr>`);
                    }
                },
                error: function () {
                    console.log("Error fetching data");
                }
            });
        });
    });
</script>
