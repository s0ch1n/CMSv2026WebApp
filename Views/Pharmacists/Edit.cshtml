@{
}
@model CMSv2026WebApp.Models.Medicine

<h2>Edit Medicine</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MedicineId" />

    <div class="form-group">
        <label asp-for="MedicineName"></label>
        <input asp-for="MedicineName" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="ExpiryDate"></label>
        <input asp-for="ExpiryDate" type="date" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="Unit"></label>
        <input asp-for="Unit" class="form-control" required />
    </div>

    <div class="form-group">
        <label asp-for="MedicineTypeId">Medicine Type</label>
        <select asp-for="MedicineTypeId" class="form-control">
            <option value="1">Capsules</option>
            <option value="2">Syrup</option>
        </select>
    </div>

    <button type="submit" class="btn btn-warning">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

