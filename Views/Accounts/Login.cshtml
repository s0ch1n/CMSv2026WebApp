@model CMSv2026WebApp.ViewModel.LoginViewModel

@{
    ViewData["Title"] = ViewData["PageTitle"];
}

<h4>Clinical Management System</h4>
<hr />
<div class="container mt-4">
    <div class="row justify-content-center">
        <!-- Left Side: Image with Shadow -->
        <div class="col-md-6 col-12 mb-3">
            <img src="~/cms.png" alt="CMS Login" class="img-fluid shadow rounded-pill" style="max-height: 350px;" />
        </div>

        <!-- Right Side: Login Form with Shadow -->
        <div class="col-md-6 col-12 mb-3">
            <div class="p-4 bg-light shadow rounded">
                <h4 class="text-center mb-3">Enter your Credentials</h4>
                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" placeholder="Username" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

