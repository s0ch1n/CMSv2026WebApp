@model CMSv2026WebApp.ViewModel.UserRegistrationViewModel

@{
    ViewData["Title"] = ViewData["PageTitle"];
}



<div class="row">
    <!--Left Side: Register Staff Form-->
    <div class="col-md-6 col-12 mb-4">
        <div class="card">
            <div class="card header">
                <h4 class="card-title">Register New Staff</h4>
            </div>
            <div class="card-body">
                <form asp-action="RegisterNewStaff" method="post">
                    <!--User Name-->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.UserName" class="form-label"></label>
                        <input asp-for="Staff.UserName" class="form-control" placeholder="Username" />
                        <span asp-validation-for="Staff.UserName" class="text-danger"></span>
                    </div>
                    <!--Password-->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Password" class="form-label"></label>
                        <input asp-for="Staff.Password" class="form-control" type="password" placeholder="Password" />
                        <span asp-validation-for="Staff.Password" class="text-danger"></span>
                    </div>
                    <!--Dropdown for RoleId-->
                    <div class="form-group">
                        <label asp-for="Staff.RoleId" class="control-label bold-label">
                            Role
                            <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Staff.RoleId" class="form-control" id="roleList">
                            <option value="">----Select Role----</option>
                            @foreach (var role in ViewBag.Roles)
                            {
                                <option value="@role.RoleId">
                                    @role.RoleName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Staff.RoleId" class="text-danger"></span>
                    </div>


                    <!--IsActive CheckBox-->
                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="Staff.IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="Staff.IsActive" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="form-group mb-3">

                        <input type="submit" value="Register" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Side: Get All Staff Details Form -->
    <div class="col-md-6 col-12 mb-4">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">All Staffs</h4>
            </div>
            <div class="card-body">
                <table class="table table-striped table-hover text-center">
                    <thead>
                        <tr>
                            <th>UserId</th>
                            <th>UserName</th>
                            <th>Role</th>
                            <th>IsActive</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Staffs)
                        {
                            <tr>
                                <td>@user.StaffId</td>
                                <td>@user.UserName</td>
                                <td>@user.Role?.RoleName</td>
                                <td>
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <input type="checkbox" class="form-check-input toggle-status"
                                               data-userid="@user.StaffId" @(user.IsActive ? "checked" : "") />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
        <script>
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": true,
                "progressBar": true,
                "positionClass": "toast-top-center",
                "preventDuplicates": false,
                "showDuration": "100",
                "hideDuration": "300",
                "timeOut": "1500",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut"
            };
        </script>

        <script>
            $(document).ready(function () {
                $(".toggle-status").on("change", function () {
                    let staffId = $(this).data("staffid");
                    let isActive = $(this).prop("checked");

                    $.ajax({
                        url: '@Url.Action("ToggleUserStatus", "Admin")',
                        type: 'POST',
                        contentType: 'application/x-www-form-urlencoded',
                        dataType: 'json',
                        data: { staffId: staffId, isActive: isActive },
                        success: function (response) {
                            if (response.success) {
                                toastr.success(response.message);
                            } else {
                                toastr.warning(response.message || "Staff status update failed.");
                            }
                        },
                        error: function (xhr, status, error) {
                            toastr.error("Failed to update staff status.");
                        }
                    });
                });
            });
        </script>

    }

