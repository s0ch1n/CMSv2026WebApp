@model CMSv2026WebApp.ViewModel.UserRegistrationViewModel

@{
    ViewData["Title"] = ViewData["PageTitle"];
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">All Staff</h4>

                    <div class="d-flex">
                        <!-- Add Staff Button -->
                        <button type="button" class="btn btn-success btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                            Add Staff
                        </button>

                        <!-- Search Box -->
                        <input type="text" id="staffSearch" class="form-control form-control-sm" placeholder="Search Staff..." />
                        <button id="searchButton" class="btn btn-primary btn-sm ms-2">Search</button>
                        <button id="clearSearch" class="btn btn-sm ms-2" style="display: none;">Back</button>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover text-center w-100">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Gender</th>
                                    <th>Age</th>
                                    <th>Date of Joining</th>
                                    <th>Mobile Number</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Edit</th>
                                    <th>View</th>
                                </tr>
                            </thead>
                            <tbody id="staffTableBody">
                                @foreach (var user in Model.Staffs)
                                {
                                    <tr class="staff-row" data-id="@user.StaffId"
                                        data-fullname="@user.FullName"
                                        data-gender="@user.Gender"
                                        data-dob="@user.DateOfBirth?.ToString("yyyy-MM-dd")"
                                        data-mobile="@user.MobileNumber"
                                        data-role="@user.Role?.RoleName"
                                        data-isactive="@user.IsActive">

                                        <td>@user.FullName</td>
                                        <td>@user.Gender</td>
                                        <td class="age-cell" data-dob="@user.DateOfBirth?.ToString("yyyy-MM-dd")"></td>
                                        <td>@user.DateOfJoining.ToString("yyyy-MM-dd")</td>
                                        <td>@user.MobileNumber</td>
                                        <td>@user.Role?.RoleName</td>
                                        <td>
                                            <div class="form-check form-switch d-flex justify-content-center">
                                                <input type="checkbox" class="form-check-input toggle-status"
                                                       data-staffid="@user.StaffId" @(user.IsActive ? "checked" : "") />
                                            </div>
                                        </td>

                                        <td>
                                            <!-- Edit Button -->
                                            <button class="btn btn-warning btn-sm edit-staff" data-id="@user.StaffId">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                        </td>

                                        <td>
                                            <!-- View Button -->
                                            <button class="btn btn-info btn-sm view-staff" data-id="@user.StaffId">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                        </td>

                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Staff Modal -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-labelledby="addStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-gradient-primary text-white">
                <h5 class="modal-title" id="addStaffModalLabel">
                    <i class="fas fa-user-plus me-2"></i>Register New Staff
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="RegisterNewStaff" method="post">
                    <!-- Full Name -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.FullName" class="form-label">
                            <i class="fas fa-user me-2"></i>Full Name
                        </label>
                        <input asp-for="Staff.FullName" class="form-control" placeholder="Enter full name" required />
                        <span asp-validation-for="Staff.FullName" class="text-danger"></span>
                    </div>

                    <!-- Gender -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Gender" class="form-label">
                            <i class="fas fa-venus-mars me-2"></i>Gender
                        </label>
                        <select asp-for="Staff.Gender" class="form-control" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Staff.Gender" class="text-danger"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.DateOfBirth" class="form-label">
                            <i class="fas fa-calendar-alt me-2"></i>Date of Birth
                        </label>
                        <input asp-for="Staff.DateOfBirth" class="form-control" type="date" required />
                        <span asp-validation-for="Staff.DateOfBirth" class="text-danger"></span>
                    </div>

                    <!-- Date of Joining -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.DateOfJoining" class="form-label">
                            <i class="fas fa-calendar-check me-2"></i>Date of Joining
                        </label>
                        <input asp-for="Staff.DateOfJoining" class="form-control" type="date" required />
                        <span asp-validation-for="Staff.DateOfJoining" class="text-danger"></span>
                    </div>

                    <!-- Mobile Number -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.MobileNumber" class="form-label">
                            <i class="fas fa-phone me-2"></i>Mobile Number
                        </label>
                        <input asp-for="Staff.MobileNumber" class="form-control" placeholder="Enter mobile number" required />
                        <span asp-validation-for="Staff.MobileNumber" class="text-danger"></span>
                    </div>

                    <!-- Username -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.UserName" class="form-label">
                            <i class="fas fa-user-circle me-2"></i>Username
                        </label>
                        <input asp-for="Staff.UserName" class="form-control" placeholder="Enter username" required />
                        <span asp-validation-for="Staff.UserName" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Password" class="form-label">
                            <i class="fas fa-lock me-2"></i>Password
                        </label>
                        <input asp-for="Staff.Password" class="form-control" type="password" placeholder="Enter password" required />
                        <span asp-validation-for="Staff.Password" class="text-danger"></span>
                    </div>

                    <!-- Role Dropdown -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.RoleId" class="form-label">
                            <i class="fas fa-user-tag me-2"></i>Role
                        </label>
                        <select asp-for="Staff.RoleId" class="form-control" id="staffRole" required>
                            <option value="">----Select Role----</option>
                            @if (ViewBag.Roles != null)
                            {
                                foreach (var role in ViewBag.Roles)
                                {
                                    <option value="@role.RoleId">@role.RoleName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="Staff.RoleId" class="text-danger"></span>
                    </div>

                    <!-- Specialization Field (Only for Doctors) -->
                    <div class="form-group mb-3" id="specializationField" style="display: none;">
                        <label asp-for="Staff.Doctor.SpecializationId" class="form-label">
                            <i class="fas fa-stethoscope me-2"></i>Specialization
                        </label>
                        <select asp-for="Staff.Doctor.SpecializationId" class="form-control">
                            <option value="">Select Specialization</option>
                            @foreach (var specialization in ViewBag.Specializations)
                            {
                                <option value="@specialization.SpecializationId">@specialization.SpecializationName</option>
                            }
                        </select>
                        <span asp-validation-for="Staff.Doctor.SpecializationId" class="text-danger"></span>
                    </div>

                    <!-- Consultation Fee (Only for Doctors) -->
                    <div class="form-group mb-3" id="consultationFeeField" style="display: none;">
                        <label asp-for="Staff.Doctor.ConsultationFee" class="form-label">
                            <i class="fas fa-dollar-sign me-2"></i>Consultation Fee
                        </label>
                        <input asp-for="Staff.Doctor.ConsultationFee" class="form-control" type="number" placeholder="Enter consultation fee" />
                        <span asp-validation-for="Staff.Doctor.ConsultationFee" class="text-danger"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.EmailAddress" class="form-label">
                            <i class="fas fa-envelope me-2"></i>Email Address
                        </label>
                        <input asp-for="Staff.EmailAddress" class="form-control" placeholder="Enter email address" required />
                        <span asp-validation-for="Staff.EmailAddress" class="text-danger"></span>
                    </div>

                    <!-- Qualification -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Qualification" class="form-label">
                            <i class="fas fa-graduation-cap me-2"></i>Qualification
                        </label>
                        <input asp-for="Staff.Qualification" class="form-control" placeholder="Enter qualification" required />
                        <span asp-validation-for="Staff.Qualification" class="text-danger"></span>
                    </div>

                    <!-- IsActive Checkbox -->
                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="Staff.IsActive" class="form-check-input" type="checkbox" checked />
                            <label asp-for="Staff.IsActive" class="form-check-label">Is Active</label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Register
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Close
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Edit Staff Modal -->
<div class="modal fade" id="editStaffModal" tabindex="-1" aria-labelledby="editStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editStaffModalLabel">Edit Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editStaffForm">
                    <input type="hidden" id="editStaffId">
                    <div class="mb-3">
                        <label for="editFullName" class="form-label">Full Name</label>
                        <input type="text" id="editFullName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editGender" class="form-label">Gender</label>
                        <select id="editGender" class="form-control" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editDateOfBirth" class="form-label">Date of Birth</label>
                        <input type="date" id="editDateOfBirth" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editDateOfJoining" class="form-label">Date of Joining</label>
                        <input type="date" id="editDateOfJoining" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editMobileNumber" class="form-label">Mobile Number</label>
                        <input type="text" id="editMobileNumber" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editUserName" class="form-label">Username</label>
                        <input type="text" id="editUserName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editPassword" class="form-label">Password</label>
                        <input type="password" id="editPassword" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editRoleId" class="form-label">Role</label>
                        <select id="editRoleId" class="form-control" required>
                            <option value="">----Select Role----</option>
                            @if (ViewBag.Roles != null)
                            {
                                foreach (var role in ViewBag.Roles)
                                {
                                    <option value="@role.RoleId">@role.RoleName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="editSpecializationField" style="display: none;">
                        <label for="editSpecializationId" class="form-label">Specialization</label>
                        <select id="editSpecializationId" class="form-control">
                            <option value="">Select Specialization</option>
                            @foreach (var specialization in ViewBag.Specializations)
                            {
                                <option value="@specialization.SpecializationId">@specialization.SpecializationName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="editConsultationFeeField" style="display: none;">
                        <label for="editConsultationFee" class="form-label">Consultation Fee</label>
                        <input type="number" id="editConsultationFee" class="form-control" placeholder="Enter consultation fee">
                    </div>
                    <div class="mb-3">
                        <label for="editEmailAddress" class="form-label">Email Address</label>
                        <input type="email" id="editEmailAddress" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="editQualification" class="form-label">Qualification</label>
                        <input type="text" id="editQualification" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" id="editIsActive" class="form-check-input">
                            <label for="editIsActive" class="form-check-label">Is Active</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const roleDropdown = document.getElementById("staffRole");
            const specializationField = document.getElementById("specializationField");
            const consultationFeeField = document.getElementById("consultationFeeField");

            function toggleDoctorFields() {
                if (roleDropdown.value === "Doctor") {
                    specializationField.style.display = "block";
                    consultationFeeField.style.display = "block";
                } else {
                    specializationField.style.display = "none";
                    consultationFeeField.style.display = "none";
                }
            }

            roleDropdown.addEventListener("change", toggleDoctorFields);
            toggleDoctorFields(); // Run on page load
        });

        // Handle Search
        $("#searchButton").on("click", function () {
            let searchQuery = $("#staffSearch").val().toLowerCase();
            $("#staffTableBody tr").each(function () {
                let fullName = $(this).find("td:nth-child(1)").text().toLowerCase();
                if (fullName.indexOf(searchQuery) !== -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });

            if (searchQuery) {
                $("#clearSearch").show();
            } else {
                $("#clearSearch").hide();
            }
        });

        // Clear search input
        $("#clearSearch").on("click", function () {
            $("#staffSearch").val('');
            $("#searchButton").click();
            $(this).hide();
        });

        $(document).ready(function () {
            // Toggle Status Functionality
            $(".toggle-status").change(function () {
                let staffId = $(this).data("staffid");
                let isActive = $(this).prop("checked");

                $.ajax({
                    url: "/Admin/ToggleUserStatus",
                    type: "POST",
                    data: { staffId: staffId, isActive: isActive },
                    success: function (response) {
                        alert(response.message);
                    },
                    error: function () {
                        alert("Error toggling status.");
                    }
                });
            });

            // Edit Button Click - Load Data into Modal
            $(".edit-staff").click(function () {
                let staffId = $(this).data("id");

                $.ajax({
                    url: "/Admin/EditStaff",
                    type: "GET",
                    data: { staffId: staffId },
                    success: function (data) {
                        if (data.staff) {
                            $("#editStaffId").val(data.staff.StaffId);
                            $("#editFullName").val(data.staff.FullName);
                            $("#editGender").val(data.staff.Gender);
                            $("#editDateOfBirth").val(data.staff.DateOfBirth ? data.staff.DateOfBirth.split('T')[0] : '');
                            $("#editDateOfJoining").val(data.staff.DateOfJoining ? data.staff.DateOfJoining.split('T')[0] : '');
                            $("#editMobileNumber").val(data.staff.MobileNumber);
                            $("#editUserName").val(data.staff.UserName);
                            $("#editPassword").val(data.staff.Password);
                            $("#editRoleId").val(data.staff.RoleId);
                            $("#editEmailAddress").val(data.staff.EmailAddress);
                            $("#editQualification").val(data.staff.Qualification);
                            $("#editIsActive").prop("checked", data.staff.IsActive);

                            if (data.staff.RoleId === "Doctor") {
                                $("#editSpecializationField").show();
                                $("#editConsultationFeeField").show();
                                $("#editSpecializationId").val(data.staff.Doctor.SpecializationId);
                                $("#editConsultationFee").val(data.staff.Doctor.ConsultationFee);
                            } else {
                                $("#editSpecializationField").hide();
                                $("#editConsultationFeeField").hide();
                            }

                            $("#editStaffModal").modal("show");
                        } else {
                            alert("Staff details not found.");
                        }
                    },
                    error: function () {
                        alert("Error fetching staff details.");
                    }
                });
            });

            // Handle Edit Form Submission
            $("#editStaffForm").submit(function (e) {
                e.preventDefault();

                let staffId = $("#editStaffId").val();
                let fullName = $("#editFullName").val();
                let gender = $("#editGender").val();
                let dateOfBirth = $("#editDateOfBirth").val();
                let dateOfJoining = $("#editDateOfJoining").val();
                let mobileNumber = $("#editMobileNumber").val();
                let userName = $("#editUserName").val();
                let password = $("#editPassword").val();
                let roleId = $("#editRoleId").val();
                let emailAddress = $("#editEmailAddress").val();
                let qualification = $("#editQualification").val();
                let isActive = $("#editIsActive").prop("checked");
                let specializationId = $("#editSpecializationId").val();
                let consultationFee = $("#editConsultationFee").val();

                let staffData = {
                    StaffId: staffId,
                    FullName: fullName,
                    Gender: gender,
                    DateOfBirth: dateOfBirth,
                    DateOfJoining: dateOfJoining,
                    MobileNumber: mobileNumber,
                    UserName: userName,
                    Password: password,
                    RoleId: roleId,
                    EmailAddress: emailAddress,
                    Qualification: qualification,
                    IsActive: isActive
                };

                if (roleId === "Doctor") {
                    staffData.Doctor = {
                        SpecializationId: specializationId,
                        ConsultationFee: consultationFee
                    };
                }

                $.ajax({
                    url: "/Admin/UpdateStaff",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ Staff: staffData }),
                    success: function (response) {
                        alert(response.message);
                        $("#editStaffModal").modal("hide");
                        location.reload();
                    },
                    error: function () {
                        alert("Error updating staff details.");
                    }
                });
            });
        });
    </script>
}

}
