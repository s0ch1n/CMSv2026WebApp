@model CMSv2026WebApp.ViewModel.UserRegistrationViewModel

@{
    ViewData["Title"] = ViewData["PageTitle"];
}

@{
    // Calculate min and max values for Date of Birth
    var maxDob = DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd"); // Max: 18 years ago
    var minDob = DateTime.Now.AddYears(-65).ToString("yyyy-MM-dd"); // Min: 65 years ago
    var today = DateTime.Now.ToString("yyyy-MM-dd"); // Today’s date for Date of Joining
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">All Staffs</h4>

                    <div class="d-flex">
                        <!-- Add Staff Button -->
                        <button type="button" class="btn btn-success btn-sm me-2" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                            Add Staff
                        </button>


                        <!-- Search Box -->
                        <input type="text" id="staffSearch" class="form-control form-control-sm" placeholder="Search Staff..." />
                        <button id="searchButton" class="btn btn-primary btn-sm ms-2">Search</button>
                        <button id="clearSearch" class="btn btn-sm ms-2" style="display: none;">Back</button>

                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover text-center w-100">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Gender</th>
                                    <th>Age</th>
                                    <th>Date of Joining</th>
                                    <th>Mobile Number</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Edit</th> 
                                </tr>
                            </thead>
                            <tbody id="staffTableBody">
                                @foreach (var user in Model.Staffs)
                                {
                                    <tr class="staff-row" data-id="@user.StaffId" data-fullname="@user.FullName"
                                        data-gender="@user.Gender" data-dob="@user.DateOfBirth?.ToString("yyyy-MM-dd")"
                                        data-mobile="@user.MobileNumber" data-role="@user.Role?.RoleName"
                                        data-isactive="@user.IsActive">

                                        <td>@user.FullName</td>
                                        <td>@user.Gender</td>
                                        <td class="age-cell" data-dob="@user.DateOfBirth?.ToString("yyyy-MM-dd")"></td>
                                        <td>@user.DateOfJoining.ToString("yyyy-MM-dd")</td>
                                        <td>@user.MobileNumber</td>
                                        <td>@user.Role?.RoleName</td>
                                        <td>@(user.IsActive ? "Active" : "Inactive")</td>
                                        <td>
                                            <!-- Edit Button -->
                                            <button class="btn btn-warning btn-sm edit-staff" data-id="@user.StaffId">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Full Width Container -->
<!-- Add Staff Modal -->
<div class="modal fade" id="addStaffModal" tabindex="-1" aria-labelledby="addStaffModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addStaffModalLabel">Register New Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="RegisterNewStaff" method="post">
                    <!-- Full Name -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.FullName" class="form-label">Full Name</label>
                        <input asp-for="Staff.FullName" class="form-control" placeholder="Full Name" />
                        <span asp-validation-for="Staff.FullName" class="text-danger"></span>
                    </div>
                    <!-- Gender -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Gender" class="form-label">Gender</label>
                        <select asp-for="Staff.Gender" class="form-control">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Staff.Gender" class="text-danger"></span>
                    </div>

                    <!-- Date of Birth -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.DateOfBirth" class="form-label">Date of Birth</label>
                        <input asp-for="Staff.DateOfBirth" class="form-control" type="date"
                               min="@minDob" max="@maxDob" />
                        <span asp-validation-for="Staff.DateOfBirth" class="text-danger"></span>
                    </div>
                    <!-- Date of Joining -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.DateOfJoining" class="form-label">Date of Joining</label>
                        <input asp-for="Staff.DateOfJoining" class="form-control" type="date" max="@today" />
                        <span asp-validation-for="Staff.DateOfJoining" class="text-danger"></span>
                    </div>

                    <!-- Mobile Number -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.MobileNumber" class="form-label">Mobile Number</label>
                        <input asp-for="Staff.MobileNumber" class="form-control" placeholder="Enter 10-digit Mobile Number"
                               pattern="[6-9]\d{9}" title="Mobile number must start with 6, 7, 8, or 9 and be exactly 10 digits"
                               maxlength="10" required />
                        <span asp-validation-for="Staff.MobileNumber" class="text-danger"></span>
                    </div>

                    <!-- Username & Password -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.UserName" class="form-label">Username</label>
                        <input asp-for="Staff.UserName" class="form-control" placeholder="Username" />
                        <span asp-validation-for="Staff.UserName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Password" class="form-label">Password</label>
                        <input asp-for="Staff.Password" class="form-control" type="password" placeholder="Password" />
                        <span asp-validation-for="Staff.Password" class="text-danger"></span>
                    </div>

                    
                    <!-- Role Dropdown -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.RoleId" class="form-label">Role</label>
                        <select asp-for="Staff.RoleId" class="form-control" id="staffRole">
                            <option value="">----Select Role----</option>
                            @foreach (var role in ViewBag.Roles)
                            {
                                <option value="@role.RoleId">@role.RoleName</option>
                            }
                        </select>
                        <span asp-validation-for="Staff.RoleId" class="text-danger"></span>
                    </div>

                    <!-- Specialization Field (Only for Doctors) -->
                    <div class="form-group mb-3" id="specializationField" style="display: none;">
                        <label asp-for="Staff.SpecializationId" class="form-label">Specialization</label>
                        <select asp-for="Staff.SpecializationId" class="form-control">
                            <option value="">Select Specialization</option>
                            @foreach (var specialization in ViewBag.Specializations)
                            {
                                <option value="@specialization.SpecializationId">@specialization.SpecializationName</option>
                            }
                        </select>
                        <span asp-validation-for="Staff.SpecializationId" class="text-danger"></span>
                    </div>

                    <!-- Consultation Fee (Only for Doctors) -->
                    <div class="form-group mb-3" id="consultationFeeField" style="display: none;">
                        <label asp-for="Staff.ConsultationFee" class="form-label">Consultation Fee</label>
                        <input asp-for="Staff.ConsultationFee" class="form-control" type="number" placeholder="Enter Consultation Fee" />
                        <span asp-validation-for="Staff.ConsultationFee" class="text-danger"></span>
                    </div>
                    <!-- Email & Qualification -->
                    <div class="form-group mb-3">
                        <label asp-for="Staff.EmailAddress" class="form-label">Email Address</label>
                        <input asp-for="Staff.EmailAddress" class="form-control" placeholder="Email Address" />
                        <span asp-validation-for="Staff.EmailAddress" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Staff.Qualification" class="form-label">Qualification</label>
                        <input asp-for="Staff.Qualification" class="form-control" placeholder="Qualification" />
                        <span asp-validation-for="Staff.Qualification" class="text-danger"></span>
                    </div>

                    <!-- IsActive Checkbox -->
                    <div class="form-group mb-3">
                        <div class="form-check">
                            <input asp-for="Staff.IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="Staff.IsActive" class="form-check-label">Is Active</label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary">Register</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Staff Details Modal -->
<!-- Staff Details (Edit) Modal -->
<div class="modal fade" id="staffDetailsModal" tabindex="-1" aria-labelledby="staffDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staffDetailsModalLabel">Edit Staff</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editStaffForm">
                    <input type="hidden" id="editStaffId"> <!-- Hidden Staff ID -->

                    <div class="form-group mb-3">
                        <label for="editStaffFullName" class="form-label">Full Name</label>
                        <input type="text" id="editStaffFullName" class="form-control" required />
                    </div>
                    <div class="form-group mb-3">
                        <label for="editStaffGender" class="form-label">Gender</label>
                        <select id="editStaffGender" class="form-control">
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    @* <div class="form-group mb-3"> *@
                    @*     <label for="editStaffDob" class="form-label">Date of Birth</label> *@
                    @*     <input type="date" id="editStaffDob" class="form-control" required /> *@
                    @* </div> *@
                    <div class="form-group mb-3">
                        <label for="editStaffMobile" class="form-label">Mobile Number</label>
                        <input type="text" id="editStaffMobile" class="form-control" required />
                    </div>

                    <div class="form-group mb-3">
                        <label for="editStaffStatus" class="form-label">Active Staff</label>
                        <input type="checkbox" id="editStaffStatus" class="form-check-input">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveEditStaffBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        $(document).ready(function () {
            // Calculate Age
            function calculateAge(birthDate) {
                const today = new Date();
                const birthDateObj = new Date(birthDate);
                let age = today.getFullYear() - birthDateObj.getFullYear();
                const month = today.getMonth() - birthDateObj.getMonth();
                if (month < 0 || (month === 0 && today.getDate() < birthDateObj.getDate())) {
                    age--;
                }
                return age;
            }

            // Update the age column with the calculated age
            $(".age-cell").each(function () {
                const dob = $(this).data("dob");
                const age = calculateAge(dob);
                $(this).text(age);
            });

                  $(document).ready(function () {
            // ✅ Edit Button Click Event
            $(document).on("click", ".edit-staff", function () {
                
                let row = $(this).closest("tr");
                let staffId = row.data('id');
                let fullName = row.data('fullname');
                let gender = row.data('gender');
                let dob = row.data('dob');
                let mobile = row.data('mobile');
                let role = row.data('role');
                let isActive = row.data('isactive');

                // Populate modal fields
                $("#editStaffId").val(staffId);
                $("#editStaffFullName").val(fullName);
                $("#editStaffGender").val(gender);
                $("#editStaffDob").val(dob);
                $("#editStaffMobile").val(mobile);
                $("#editStaffRole").val(role);
                $("#editStaffStatus").prop("checked", isActive);

                // Show modal
                $("#staffDetailsModal").modal('show');
            });

            // ✅ Save Edited Staff Details
            $("#saveEditStaffBtn").on("click", function () {
                let updatedData = {
                    Staff: {
                        StaffId: $("#editStaffId").val(),
                        FullName: $("#editStaffFullName").val(),
                        Gender: $("#editStaffGender").val(),
                        //DateOfBirth: $("#editStaffDob").val(),
                        MobileNumber: $("#editStaffMobile").val(),
                       // RoleId: $("#editStaffRole").val(),
                        IsActive: $("#editStaffStatus").is(":checked")
                    }
                };
                        $("#saveEditStaffBtn").on("click", function () {
            let updatedData = {
                Staff: {
                    StaffId: $("#editStaffId").val(),
                    FullName: $("#editStaffFullName").val() || null,
                    Gender: $("#editStaffGender").val() || null,
                   // DateOfBirth: $("#editStaffDob").val() ? new Date($("#editStaffDob").val()).toISOString() : null,
                    MobileNumber: $("#editStaffMobile").val() || null,
                    //RoleId: $("#editStaffRole").val() || null,
                    IsActive: $("#editStaffStatus").is(":checked")
                }
            };

            $.ajax({
                url: '@Url.Action("UpdateStaff", "Admin")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(updatedData),
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                success: function (response) {
                    if (response.success) {
                        toastr.success("Staff updated successfully!");
                        $("#staffDetailsModal").modal("hide");
                        location.reload(); // Refresh to reflect changes
                    } else {
                        toastr.error(response.message || "Error updating staff.");
                    }
                },
                error: function () {
                    toastr.error("Request failed! Try again.");
                }
            });
        });
                $.ajax({
                    url: '@Url.Action("UpdateStaff", "Admin")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(updatedData),
                    headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        if (response.success) {
                            toastr.success("Staff updated successfully!");

                            // ✅ Update row dynamically
                            let row = $(`tr[data-id='${updatedData.Staff.StaffId}']`);
                            row.find("td:nth-child(1)").text(updatedData.Staff.FullName);
                            row.find("td:nth-child(2)").text(updatedData.Staff.Gender);
                           // row.find("td:nth-child(3)").text(updatedData.Staff.DateOfBirth);
                            row.find("td:nth-child(5)").text(updatedData.Staff.MobileNumber);
                            //row.find("td:nth-child(6)").text($("#editStaffRole option:selected").text());
                            row.find(".toggle-status").prop("checked", updatedData.Staff.IsActive);

                            // Hide modal
                            $("#staffDetailsModal").modal("hide");
                        } else {
                            toastr.error(response.message || "Error updating staff.");
                        }
                    },
                    error: function () {
                        toastr.error("Request failed! Try again.");
                    }
                });
            });
        });
             
            $(document).ready(function () {
            function toggleDoctorFields() {
                var selectedRole = $("#staffRole option:selected").text().toLowerCase();
                if (selectedRole === "doctor") {
                    $("#specializationField").show();
                    $("#consultationFeeField").show();
                } else {
                    $("#specializationField").hide();
                    $("#consultationFeeField").hide();
                }
            }

            // ✅ On role change, toggle fields
            $("#staffRole").change(toggleDoctorFields);

            // ✅ Call on page load (for Edit Mode)
            toggleDoctorFields();
        });
            // ✅ Remove row-click functionality (previously opening modal)
            $(".staff-row").off("click");

            // Handle Search
            $("#searchButton").on("click", function () {
                let searchQuery = $("#staffSearch").val().toLowerCase();
                $("#staffTableBody tr").each(function () {
                    let fullName = $(this).find("td:nth-child(1)").text().toLowerCase();
                    if (fullName.indexOf(searchQuery) !== -1) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });

                if (searchQuery) {
                    $("#clearSearch").show();
                } else {
                    $("#clearSearch").hide();
                }
            });

            // Clear search input
            $("#clearSearch").on("click", function () {
                $("#staffSearch").val('');
                $("#searchButton").click();
                $(this).hide();
            });

                    $(".toggle-status").on("change", function () {
            let staffId = parseInt($(this).data("staffid")); // Ensure correct ID retrieval
            let isActive = $(this).prop("checked");

            $.ajax({
                url: '/Admin/ToggleUserStatus', // Ensure correct route
                type: 'POST',
                contentType: 'application/x-www-form-urlencoded',
                dataType: 'json',
                data: { staffId: staffId, isActive: isActive },
                success: function (response) {
                    if (response.success) {
                        toastr.success(response.message);
                    } else {
                        toastr.warning(response.message || "Staff status update failed.");
                    }
                },
                error: function () {
                    toastr.error("Failed to update staff status.");
                }
            });
        });

        });
    </script>

}