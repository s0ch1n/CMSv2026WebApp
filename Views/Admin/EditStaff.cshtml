@model CMSv2026WebApp.ViewModel.UserRegistrationViewModel

@{
    ViewData["Title"] = "Edit Staff";
}

<h2>Edit Staff</h2>

<form asp-action="UpdateStaff" method="post">
    <div class="form-group">
        <label asp-for="Staff.FullName"></label>
        <input asp-for="Staff.FullName" class="form-control" />
        <span asp-validation-for="Staff.FullName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Staff.Gender"></label>
        <input asp-for="Staff.Gender" class="form-control" />
        <span asp-validation-for="Staff.Gender" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Staff.DateOfBirth"></label>
        <input asp-for="Staff.DateOfBirth" class="form-control" />
        <span asp-validation-for="Staff.DateOfBirth" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Staff.MobileNumber"></label>
        <input asp-for="Staff.MobileNumber" class="form-control" />
        <span asp-validation-for="Staff.MobileNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Staff.RoleId"></label>
        <select asp-for="Staff.RoleId" class="form-control" asp-items="@(new SelectList(Model.Roles, "RoleId", "RoleName"))"></select>
        <span asp-validation-for="Staff.RoleId" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Staff.IsActive"></label>
        <input asp-for="Staff.IsActive" class="form-control" />
        <span asp-validation-for="Staff.IsActive" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
