@model CMSv2026WebApp.ViewModel.MedicineViewModel

@{
    ViewData["Title"] = "Edit Medicine";
}

<h2>Edit Medicine</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MedicineId" />

    <div class="form-group">
        <label>Medicine Name</label>
        <input asp-for="MedicineName" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Medicine Type</label>
        <select asp-for="MedicineTypeId" asp-items="@(new SelectList(ViewBag.MedicineTypes, "MedicineTypeId", "MedicineTypeName"))" class="form-control"></select>
    </div>

    <div class="form-group">
        <label>Unit</label>
        <input asp-for="Unit" class="form-control" type="number" required />
    </div>

    <div class="form-group">
        <label>Expiry Date</label>
        <input asp-for="ExpiryDate" class="form-control" type="date" required />
    </div>

    <button type="submit" class="btn btn-success">Update</button>
    <a asp-action="View" class="btn btn-secondary">Cancel</a>
</form>
