@model CMSv2026WebApp.ViewModel.MedicineViewModel

@{
    ViewData["Title"] = "Add Medicine";
}

<h2>Add Medicine</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="MedicineName"></label>
        <input asp-for="MedicineName" class="form-control" required />
        <span asp-validation-for="MedicineName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MedicineTypeId"></label>
        <select asp-for="MedicineTypeId" asp-items="@(new SelectList(Model.MedicineTypes, "Value", "Text"))" class="form-control" required>
            <option value="">-- Select Medicine Type --</option>
        </select>
        <span asp-validation-for="MedicineTypeId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Unit"></label>
        <input asp-for="Unit" type="number" class="form-control" required />
        <span asp-validation-for="Unit" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ExpiryDate"></label>
        <input asp-for="ExpiryDate" type="date" class="form-control" required />
        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
